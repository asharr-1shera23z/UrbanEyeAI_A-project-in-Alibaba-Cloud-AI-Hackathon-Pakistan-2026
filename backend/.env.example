# Copy this file to .env and adjust as needed. Every value has a sane
# development default in app/config.py, so a bare `cp .env.example .env`
# already works out of the box with SQLite + local file storage.

APP_NAME=UrbanEye AI Backend
ENV=development
DEBUG=true

# SQLite by default (zero setup). For PostgreSQL/PostGIS instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://urbaneye:password@localhost:5432/urbaneye
DATABASE_URL=sqlite:///./urbaneye.db

# Generate a real secret for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_this_is_not_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# The existing Vite frontend's dev server origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_BACKEND=local
STORAGE_DIR=./storage/uploads
MEDIA_URL_PREFIX=/media
PUBLIC_BASE_URL=http://localhost:8000

# Only read when STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# "mock" needs no model file. "yolo" loads AI_MODEL_PATH if present, and
# transparently falls back to mock if it isn't.
AI_ENGINE=mock
AI_MODEL_PATH=./models/urbaneye_yolo.pt
AI_CONFIDENCE_THRESHOLD=0.35

DUPLICATE_RADIUS_METERS=60
DUPLICATE_WINDOW_DAYS=14
